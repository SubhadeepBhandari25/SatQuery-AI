# SatQuery AI - Environment Configuration
# SIH26167: Multimodal Remote Sensing Image Analysis through Text Queries

# OpenAI Configuration (Optional: provides LLM explanation over structured evidence)
# If left unset or empty, the deterministic Remote Sensing Synthesizer is used automatically.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Server & Network Settings
HOST=127.0.0.1
PORT=8008

# Hardware Awareness ('auto', 'cuda', 'cpu')
DEVICE=auto

# Security & Upload Configuration
MAX_UPLOAD_SIZE_MB=150
SESSION_RETENTION_HOURS=24
